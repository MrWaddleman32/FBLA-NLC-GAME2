  m_Name: 
  m_EditorClassIdentifier: 
  messages:
  - actorID: 1
    message: Hey How are you
  - actorID: 0
    message: Hi. Have you seen the first piece of the business beacon?
  - actorID: 1
    message: Yeah, its in the chest over there
  - actorID: 0
    message: Okay thanks, but is there a key I need
  - actorID: 1
    message: Yes, it is said that somewhere in this forest, there is a dinosaur that
      will give you the key if you answer his questions. No one has done it before
      because they are so hard.
  - actorID: 0
    message: Oh, okay. I will try my best
  - actorID: 1
    message: Good luck! FOLLOW THE PATH
