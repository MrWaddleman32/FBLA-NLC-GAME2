  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4e3d334e73d3c4e4dab8e692eac6f500, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  messages:
  - actorID: 1
    message: Hey, what are you doing here?
  - actorID: 0
    message: Hi. Have you seen the first piece of the business beacon?
  - actorID: 1
    message: Yeah, its in the chest over there
  - actorID: 0
    message: Okay thanks, but is there a key I need
  - actorID: 1
    message: Yeah, I have your key. But you will have to answer 2 difficult questions
      for it. Its not going to be easy
  - actorID: 0
    message: Okay Im up for it.
  - actorID: 1
    message: Come a little closer and I will tell you.
  actors:
  - name: Player
    sprite: {fileID: -815099123, guid: 557e6721bedab8c4a8bea57b2708c074, type: 3}
  - name: Debt-Dinosaur
    sprite: {fileID: 21300000, guid: 7b1172ead9fdac0419ca5fc7dc2a3030, type: 3}
